{
	"name": "MarkItDown Development",
	"build": {
		"context": "..",
		"dockerfile": "../Dockerfile",
		"args": {
			"INSTALL_GIT": "true"
		}
	},
	"features": {
		"ghcr.io/devcontainers-extra/features/hatch:2": {},
		"ghcr.io/devcontainers/features/git:1": {
			"version": "latest",
			"ppa": true
		
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"eamodio.gitlens",
				"charliermarsh.ruff"
			],
			"settings": {
				"python.testing.pytestEnabled": true,
				"git.enableSmartCommit": true,
				"git.autofetch": true
			}
		}
	},
	"remoteUser": "root"
}
